{
  "name": "home-control",
  "version": "1.0.0",
  "private": true,
  "description": "Home Control - Proyecto Andorra. Monorepo: backend Node + frontend Next + tipos compartidos.",
  "workspaces": [
    "services",
    "web",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace services",
    "dev:web": "npm run dev --workspace web",
    "build:api": "npm run build --workspace services",
    "build:web": "npm run build --workspace web",
    "mock": "npm run mock --workspace services"
  }
}
