# Configuración de Base de Datos
POSTGRES_USER=homeassistant
POSTGRES_PASSWORD=mi_password_seguro
POSTGRES_DB=home_assistant_db

# Configuración de Home Assistant
HASS_TIMEZONE=Europe/Andorra

# Configuración de MQTT
MQTT_USER=mqtt_user
MQTT_PASSWORD=mqtt_password

# Configuración de Node.js
DATABASE_URL=postgres://homeassistant:mi_password_seguro@postgres:5432/home_assistant_db
HASS_TOKEN=tu_long_lived_access_token_aqui

\n# Configuración de Docker (Local vs Prod)\n# En Mac/Windows usar: bridge y 8123\n# En RPi (Prod) usar: host y dejar HASS_PORT vacío o comentado\nDOCKER_NETWORK_MODE=bridge\nHASS_PORT=8123

** En mac
DOCKER_NETWORK_MODE=bridge
HASS_PORT=8123
HASS_URL=http://localhost:8123

** En RPi
DOCKER_NETWORK_MODE=host
HASS_PORT=
HASS_URL=http://homeassistant:8123